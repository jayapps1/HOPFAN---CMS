# Example only. Keep the existing .env and encryption key for an existing installation.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hopfan_db
DB_USER=your_database_user
DB_PASSWORD=
APP_ENCRYPTION_KEY=
SESSION_IDLE_MINUTES=30
SEED_ADMIN_EMAIL=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=

# Online API only. Development stays on loopback; do not replace your .env.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
API_DOCS_ENABLED=true
API_ALLOWED_HOSTS=127.0.0.1,localhost
WEB_PUBLIC_ORIGIN=http://localhost:3000
WEB_PORTAL_ORIGIN=http://localhost:3001

# Browser authentication. Secure defaults to true in staging/production.
WEB_SESSION_IDLE_MINUTES=30
WEB_SESSION_MAX_HOURS=12
WEB_CSRF_SESSION_MINUTES=10
WEB_COOKIE_SAMESITE=lax
# WEB_COOKIE_SECURE=false  # Local HTTP only; staging/production require true.
# WEB_SESSION_COOKIE_NAME=hopfan_session  # Production defaults to __Host-hopfan_session.
WEB_LOGIN_RATE_WINDOW_SECONDS=900
WEB_LOGIN_RATE_IP_LIMIT=30
WEB_LOGIN_RATE_ACCOUNT_LIMIT=10
WEB_CSRF_RATE_WINDOW_SECONDS=60
WEB_CSRF_RATE_IP_LIMIT=60

# Public donations: backend only. This release accepts TEST keys exclusively.
# Configure the currency for your Paystack merchant account; GHS is the default.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS
# Callback: WEB_PUBLIC_ORIGIN/donate/result
# Webhook: your publicly reachable API/api/v1/payments/paystack/webhook
